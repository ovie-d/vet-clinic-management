    <mxGraphModel dx="2214" dy="779" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class ClinicManagementSystem {\n    -List~Staff~ staffMembers\n    -List~Owner~ owners\n    -List~Pet~ pets\n    -List~Appointment~ appointments\n    -DatabaseManager databaseManager\n    -AppointmentService appointmentService\n    +start() void\n    +loadData() void\n    +saveChanges() void\n  }\n\n  class Person {\n    &lt;&lt;abstract&gt;&gt;\n    -String name\n    +getName() String\n    +setName(name: String) void\n  }\n\n  class Staff {\n    &lt;&lt;abstract&gt;&gt;\n    -int staffId\n    -String staffType\n    +getStaffId() int\n    +getStaffType() String\n  }\n\n  class Veterinarian {\n    -String expertise\n    +getExpertise() String\n  }\n\n  class Receptionist {\n    +getStaffType() String\n  }\n\n  class Owner {\n    -int ownerId\n    -String phoneNumber\n    -String email\n    -List~Pet~ pets\n    +addPet(pet: Pet) void\n    +getPets() List~Pet~\n  }\n\n  class Pet {\n    &lt;&lt;abstract&gt;&gt;\n    -int petId\n    -String name\n    -int age\n    -Owner owner\n    -String petType\n    +getName() String\n    +getAge() int\n    +getOwner() Owner\n    +getPetType() String\n  }\n\n  class Dog {\n    -boolean vaccinated\n    +isVaccinated() boolean\n  }\n\n  class Cat {\n    -boolean indoor\n    +isIndoor() boolean\n  }\n\n  class Appointment {\n    -int appointmentId\n    -Pet pet\n    -Veterinarian veterinarian\n    -LocalDateTime dateTime\n    -String notes\n    +getDateTime() LocalDateTime\n    +getVeterinarian() Veterinarian\n  }\n\n  class AppointmentService {\n    &lt;&lt;interface&gt;&gt;\n    +scheduleAppointment(appointment: Appointment) void\n    +cancelAppointment(appointmentId: int) void\n    +findAppointmentsByDate(date: LocalDate) List~Appointment~\n  }\n\n  class AppointmentManager {\n    -List~Appointment~ appointments\n    -int dailyAppointmentLimit\n    +scheduleAppointment(appointment: Appointment) void\n    +cancelAppointment(appointmentId: int) void\n    +hasTimeConflict(appointment: Appointment) boolean\n    +exceedsDailyLimit(appointment: Appointment) boolean\n  }\n\n  class DatabaseManager {\n    -Connection connection\n    -String URL\n    -String USERNAME\n    -String PASSWORD\n    +connect() void\n    +loadStaff() List~Staff~\n    +loadOwners() List~Owner~\n    +loadPets() List~Pet~\n    +loadAppointments() List~Appointment~\n    +saveStaff(staff: Staff) void\n    +saveOwner(owner: Owner) void\n    +savePet(pet: Pet) void\n    +saveAppointment(appointment: Appointment) void\n    +close() void\n  }\n\n  class ClinicCLI {\n    -ClinicManagementSystem system\n    +run() void\n    +login() boolean\n    +displayMenu() void\n    +registerOwner() void\n    +registerPet() void\n    +scheduleAppointment() void\n    +cancelAppointment() void\n    +searchRecords() void\n  }\n\n  class StaffManager {\n    -List~Staff~ staffMembers\n    -static int totalStaff\n    +addStaff(staff: Staff) void\n    +findStaff(staffId: int) Staff\n    +getTotalStaff() int\n  }\n\n  class OwnerManager {\n    -List~Owner~ owners\n    -static int totalOwners\n    +addOwner(owner: Owner) void\n    +findOwner(ownerId: int) Owner\n    +getTotalOwners() int\n  }\n\n  class ClinicException {\n    &lt;&lt;exception&gt;&gt;\n  }\n\n  class DatabaseConnectionException {\n    &lt;&lt;exception&gt;&gt;\n  }\n\n  class AppointmentConflictException {\n    &lt;&lt;exception&gt;&gt;\n  }\n\n  class DailyLimitExceededException {\n    &lt;&lt;exception&gt;&gt;\n  }\n\n  class InvalidRecordException {\n    &lt;&lt;exception&gt;&gt;\n  }\n\n  class ClinicConstants {\n    &lt;&lt;final&gt;&gt;\n    +MAX_APPOINTMENTS_PER_VET_PER_DAY: int\n    +DATABASE_URL: String\n  }\n\n  Person &lt;|-- Staff\n  Person &lt;|-- Owner\n  Staff &lt;|-- Veterinarian\n  Staff &lt;|-- Receptionist\n  Pet &lt;|-- Dog\n  Pet &lt;|-- Cat\n\n  Owner \&quot;1\&quot; o-- \&quot;1..*\&quot; Pet : owns\n  Pet \&quot;1\&quot; --&gt; \&quot;1\&quot; Owner : belongs to\n  Appointment \&quot;1\&quot; --&gt; \&quot;1\&quot; Pet : for\n  Appointment \&quot;1\&quot; --&gt; \&quot;1\&quot; Veterinarian : assigned to\n\n  AppointmentManager ..|&gt; AppointmentService\n  ClinicManagementSystem --&gt; DatabaseManager\n  ClinicManagementSystem --&gt; AppointmentService\n  ClinicManagementSystem --&gt; StaffManager\n  ClinicManagementSystem --&gt; OwnerManager\n  ClinicManagementSystem --&gt; ClinicCLI\n  AppointmentManager --&gt; Appointment\n  DatabaseManager --&gt; Staff\n  DatabaseManager --&gt; Owner\n  DatabaseManager --&gt; Pet\n  DatabaseManager --&gt; Appointment\n\n  DatabaseConnectionException --|&gt; ClinicException\n  AppointmentConflictException --|&gt; ClinicException\n  DailyLimitExceededException --|&gt; ClinicException\n  InvalidRecordException --|&gt; ClinicException\n  DatabaseManager ..&gt; DatabaseConnectionException\n  AppointmentManager ..&gt; AppointmentConflictException\n  AppointmentManager ..&gt; DailyLimitExceededException\n  StaffManager ..&gt; InvalidRecordException\n  OwnerManager ..&gt; InvalidRecordException\n  AppointmentManager --&gt; ClinicConstants\n  StaffManager --&gt; ClinicConstants\n  OwnerManager --&gt; ClinicConstants&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="176">
